// Shared VERSIONINFO block. Include it after defining AEPT_FILE_DESC,
// AEPT_ORIGINAL_NAME and AEPT_FILETYPE.

#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     AEPT_VERSION_BIN
 PRODUCTVERSION  AEPT_VERSION_BIN
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        AEPT_FILETYPE
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      AEPT_COMPANY
            VALUE "FileDescription",  AEPT_FILE_DESC
            VALUE "FileVersion",      AEPT_VERSION_STR
            VALUE "InternalName",     AEPT_ORIGINAL_NAME
            VALUE "LegalCopyright",   AEPT_COPYRIGHT
            VALUE "OriginalFilename", AEPT_ORIGINAL_NAME
            VALUE "ProductName",      AEPT_PRODUCT
            VALUE "ProductVersion",   AEPT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
